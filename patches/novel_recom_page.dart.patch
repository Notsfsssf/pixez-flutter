+      builder: (dialogContext) {
+        return AlertDialog(
+          title: Text('${I18n.of(dialogContext).block_user}?'),
+          content: Text('${novel.user.name} (${novel.user.id})'),
+          actions: <Widget>[
+            TextButton(
+              child: Text(I18n.of(dialogContext).cancel),
+              onPressed: () => Navigator.pop(dialogContext),
